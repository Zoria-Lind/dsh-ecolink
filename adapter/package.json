{
  "name": "@zoria-lind/dsh-ecolink-adapter",
  "version": "1.1.1",
  "description": "DSH 跨端记忆：指定全文读取、侧栏浏览与注入、通用/非通用分类",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js"
  },
  "files": [
    "src",
    "extension/core",
    "service",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": "0.2.2-rc.1",
      "dshReleases": {
        "0.2.2-rc.1": "compatible"
      }
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "memory",
    "ecolink",
    "deepseek",
    "dsh-plugin",
    "deepseek-harness"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zoria-Lind/dsh-ecolink.git",
    "directory": "adapter"
  },
  "engines": {
    "node": ">=18.0.0",
    "dsh": "0.2.2-rc.1"
  }
}
