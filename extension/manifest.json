{
  "manifest_version": 3,
  "name": "dsh-ecolink-web",
  "version": "0.3.0",
  "description": "打通 DeepSeek 网页版与本地 DSH 的记忆生态:网页端记住的 DSH 直接用,DSH 里产生的网页端也能读到。",
  "permissions": [
    "storage",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "dsh-ecolink"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "content.js",
        "panel.js",
        "artifact.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inject.js",
        "core/artifact.mjs"
      ],
      "matches": [
        "https://chat.deepseek.com/*"
      ]
    }
  ]
}
